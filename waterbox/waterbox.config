    {
      "id": "7800.u7",
      "display": "Atari 7800 (NTSC): 7800.u7",
      "description": "A ROM of the Atari 7800 (NTSC) (4 KB), which MAME names 7800.u7. Used by: Atari 7800 (NTSC). It is part of the machine, so you supply it, and the core checks it is the right one.",
