{
  "coreName": "MAME Home Systems",
  "author": "The MAME team; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-mamehome",
  "romFile": "game",
  "deterministic": true,
  "suggestSettings": true,
  "memoryLayoutMiB": [
    1024,
    8,
    8,
    64,
    1024
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as a machine touches it.",
  "video": {
    "_comment": "The BUFFER CAPACITY. Each machine has its own picture size, so the live size comes from GetVideoWidth/Height every frame, and the shape its screen was shown in from GetDisplayAspectX/Y.",
    "width": 2048,
    "height": 2048,
    "virtualWidth": 640,
    "virtualHeight": 480,
    "vsyncNumerator": 60000,
    "vsyncDenominator": 1000,
    "_vsync_note": "Every machine has its own refresh rate; GetVsyncNumerator reports the screen's, in thousandths of a hertz.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "MAME's mix of the machine's sound, 48 kHz stereo, all of a frame's at its end.",
    "rate": 48000,
    "samplesPerFrame": 4096,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "systemNames": {
    "A78": "Atari 7800",
    "INTV": "Intellivision",
    "VEC": "Vectrex",
    "O2": "Odyssey 2",
    "ChannelF": "Channel F",
    "AmstradCPC": "Amstrad CPC",
    "TI83": "TI-83",
    "BBC": "BBC Micro"
  },
  "settings": [
    {
      "name": "machine",
      "display": "Machine",
      "type": "enum",
      "options": [
        "a7800",
        "a7800p",
        "intv",
        "intv2",
        "intvsrs",
        "intvoice",
        "intvecs",
        "vectrex",
        "odyssey2",
        "videopac",
        "videopacf",
        "videopacp",
        "jopac",
        "channelf",
        "channlf2",
        "cpc464",
        "cpc664",
        "cpc6128",
        "cpc6128f",
        "cpc6128s",
        "cpc6128sp",
        "cpc464p",
        "cpc6128p",
        "gx4000",
        "ti83",
        "bbca",
        "bbcb",
        "bbcbp",
        "bbcbp128",
        "bbcm"
      ],
      "default": "a7800",
      "description": "Which machine this project is, by MAME's name for it. The choice is saved in the project and recorded in the movie. Atari 7800: a7800 (Atari 7800 (NTSC)), a7800p (Atari 7800 (PAL)); Intellivision: intv (Intellivision), intv2 (Intellivision II), intvsrs (Super Video Arcade), intvoice (Intellivision w/IntelliVoice expansion), intvecs (Intellivision w/Entertainment Computer System + Intellivoice expansions); Vectrex: vectrex (Vectrex); Odyssey 2: odyssey2 (Odyssey 2 (US)), videopac (Videopac G7000 (Europe)), videopacf (Videopac C52 (France)), videopacp (Videopac+ G7400 (Europe)), jopac (Jopac JO7400 (France)); Channel F: channelf (Channel F), channlf2 (Channel F II); Amstrad CPC: cpc464 (Amstrad CPC464), cpc664 (Amstrad CPC664), cpc6128 (Amstrad CPC6128), cpc6128f (Amstrad CPC6128 (France, AZERTY Keyboard)), cpc6128s (Amstrad CPC6128 (Sweden/Finland)), cpc6128sp (Amstrad CPC6128 (Spain)), cpc464p (Amstrad CPC464+), cpc6128p (Amstrad CPC6128+), gx4000 (Amstrad GX4000); TI-83: ti83 (TI-83); BBC Micro: bbca (BBC Micro Model A), bbcb (BBC Micro Model B), bbcbp (BBC Micro Model B+ 64K), bbcbp128 (BBC Micro Model B+ 128K), bbcm (BBC Master 128)."
    },
    {
      "name": "bios",
      "display": "BIOS",
      "type": "enum",
      "options": [
        "Atari 7800",
        "Atari 7800 (prototype with Asteroids)"
      ],
      "default": "Atari 7800",
      "description": "Which of the machine's BIOS versions it starts with. The default is MAME's. A movie needs the same one to play back.",
      "when": [
        "a7800"
      ]
    },
    {
      "name": "dip.Left Difficulty Switch",
      "display": "Left Difficulty Switch",
      "type": "enum",
      "options": [
        "A - Right Position",
        "B - Left Position"
      ],
      "default": "A - Right Position",
      "description": "A switch on the console, as MAME names it: 'Left Difficulty Switch'. The machine reads it, so a movie needs the same value to play back. The default is MAME's.",
      "when": [
        "a7800",
        "a7800p"
      ]
    },
    {
      "name": "dip.Right Difficulty Switch",
      "display": "Right Difficulty Switch",
