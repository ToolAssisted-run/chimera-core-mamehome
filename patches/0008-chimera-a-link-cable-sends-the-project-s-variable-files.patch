@@ -0,0 +1,27 @@
+// license:BSD-3-Clause
+// copyright-holders:Sergio Martin
+/*
+ chimera: a computer at the other end of the link cable that sends a
+ Chimera project's variable files (.83p, .83g, .8xp...) to a TI-83 or
+ TI-83 Plus, the way TI's link software does: silently (the calculator
+ need not be on its Receive screen), one variable after another, once the
+ calculator has had time to start. Only in the Chimera core's build.
+ */
+#ifndef MAME_BUS_TI8X_CHIMERAFILE_H
+#define MAME_BUS_TI8X_CHIMERAFILE_H
+
+#pragma once
+
+#include "ti8x.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+
+DECLARE_DEVICE_TYPE(TI8X_CHIMERA_FILE, device_ti8x_link_port_interface)
+
+// the Chimera core's frontend: the files to send, by name, in order
+std::vector<std::pair<std::string, std::vector<u8>>> const &chimera_ti8x_files();
+
+#endif // MAME_BUS_TI8X_CHIMERAFILE_H
