+// A disk image as an Extended DSK file: each track's sectors decoded from its
+// MFM cells in the order they pass the head, with their IDs (C, H, R, N), a
+// deleted-data mark and a data CRC error kept in the sector's status bytes,
+// so a copy-protected disk survives as well as a plain one.
+class chimera_edsk : public floppy_image_format_t
+{
+public:
+	static std::vector<uint8_t> encode(const floppy_image &image)
+	{
+		int tracks, heads;
+		image.get_actual_geometry(tracks, heads);
+		heads = std::max(heads, 1);
+		tracks = std::min(tracks, 204 / heads);
+		std::vector<std::vector<uint8_t>> blocks;
+		int used = 0;
+		for (int t = 0; t < tracks; t++)
+			for (int h = 0; h < heads; h++)
+			{
+				blocks.push_back(image.track_is_formatted(t, h) ? track_block(t, h, image) : std::vector<uint8_t>());
+				if (!blocks.back().empty()) used = t + 1;
+			}
+		std::vector<uint8_t> out(256, 0);
+		std::memcpy(out.data(), "EXTENDED CPC DSK File\r\nDisk-Info\r\n", 34);
+		std::memcpy(out.data() + 34, "Chimera       ", 14);
+		out[48] = uint8_t(used);
+		out[49] = uint8_t(heads);
+		for (int i = 0; i < used * heads; i++)
+		{
+			out[52 + i] = uint8_t(blocks[i].size() / 256);
+			out.insert(out.end(), blocks[i].begin(), blocks[i].end());
+		}
+		return out;
+	}
+
+private:
+	struct sector { uint8_t c, h, r, n, st1, st2; std::vector<uint8_t> data; };
+
+	static uint16_t crc(uint16_t value, uint8_t byte)
+	{
+		value ^= uint16_t(byte) << 8;
+		for (int i = 0; i < 8; i++)
+			value = (value & 0x8000) ? uint16_t((value << 1) ^ 0x1021) : uint16_t(value << 1);
+		return value;
+	}
+
+	static std::vector<uint8_t> track_block(int track, int head, const floppy_image &image)
+	{
+		// double density: 2 microseconds a cell
+		std::vector<bool> const bits = generate_bitstream_from_track(track, head, 2000, image);
+		uint32_t const n = uint32_t(bits.size());
+		if (n < 1000) return {};
+		// MAME's own scan (extract_sectors_from_bitstream_mfm_pc): every ID
+		// block and data block, by the sync marks before them, the 16 cells
+		// before the index read first so a mark across it is found
+		std::vector<uint32_t> ids;
+		std::vector<std::pair<uint32_t, uint8_t>> datas;   // where the data starts, and its mark
+		uint16_t shift = 0;
+		for (uint32_t i = 0; i < 16; i++)
+			if (bits[n - 16 + i]) shift |= 0x8000 >> i;
+		for (uint32_t i = 0; i < n; i++)
+		{
+			shift = uint16_t((shift << 1) | (bits[i] ? 1 : 0));
+			if (shift != 0x4489) continue;
+			uint16_t header;
+			uint32_t pos = i + 1;
+			do
+			{
+				header = 0;
+				for (int j = 0; j < 16; j++)
+				{
+					// a cell, and on to the next (round the index), as MAME's sbit_rp
+					if (bits[pos]) header |= 0x8000 >> j;
+					if (++pos == n) pos = 0;
+				}
+			} while (header == 0x4489 && pos > i);
+			uint8_t mark = 0;
+			switch (header)
+			{
+			case 0x5554: case 0x5555: mark = 0xfe; break;
+			case 0x554a: mark = 0xf8; break;
+			case 0x5549: mark = 0xf9; break;
+			case 0x5544: mark = 0xfa; break;
+			case 0x5545: mark = 0xfb; break;
+			default: break;
+			}
+			if (!mark) continue;
+			if (mark == 0xfe) ids.push_back(pos); else datas.emplace_back(pos, mark);
+			if (pos <= i) break;    // a mark across the index: the turn is done
+			i = pos - 1;
+		}
+		std::vector<sector> sectors;
+		for (uint32_t id : ids)
+		{
+			uint32_t pos = id;
+			sector sec;
+			sec.c = sbyte_mfm_r(bits, pos); sec.h = sbyte_mfm_r(bits, pos);
+			sec.r = sbyte_mfm_r(bits, pos); sec.n = sbyte_mfm_r(bits, pos);
+			sec.st1 = 0x01;    // no data mark, unless one is found
+			sec.st2 = 0x01;
+			// its data: the data block 704 cells on (1008 in perpendicular
+			// format), give or take 128, as MAME pairs them - round the index
+			for (auto const &d : datas)
+			{
+				uint32_t const delta = (d.first + n - id) % n;
+				if (delta < 704 - 128 || delta > 1008 + 128) continue;
+				size_t const length = size_t(128) << std::min<int>(sec.n, 6);
+				uint32_t p = d.first;
+				uint16_t c = 0xffff;
+				for (int k = 0; k < 3; k++) c = crc(c, 0xa1);
+				c = crc(c, d.second);
+				sec.data.resize(length);
+				for (size_t k = 0; k < length; k++) { sec.data[k] = sbyte_mfm_r(bits, p); c = crc(c, sec.data[k]); }
+				c = crc(c, sbyte_mfm_r(bits, p));
+				c = crc(c, sbyte_mfm_r(bits, p));
+				sec.st1 = c ? 0x20 : 0x00;                                           // data error
+				sec.st2 = uint8_t((c ? 0x20 : 0x00) | (d.second == 0xf8 ? 0x40 : 0x00));   // and a deleted mark
+				break;
+			}
+			sectors.push_back(std::move(sec));
+		}
+		if (sectors.empty()) return {};
+		size_t const info = (0x18 + 8 * sectors.size() + 255) & ~size_t(255);
+		std::vector<uint8_t> block(info, 0);
+		std::memcpy(block.data(), "Track-Info\r\n", 12);
+		block[16] = uint8_t(track);
+		block[17] = uint8_t(head);
+		block[20] = sectors[0].n;
+		block[21] = uint8_t(sectors.size());
+		block[22] = 0x4e;
+		block[23] = 0xe5;
+		for (size_t k = 0; k < sectors.size(); k++)
+		{
+			sector const &sec = sectors[k];
+			uint8_t *e = block.data() + 0x18 + 8 * k;
+			e[0] = sec.c; e[1] = sec.h; e[2] = sec.r; e[3] = sec.n; e[4] = sec.st1; e[5] = sec.st2;
+			e[6] = uint8_t(sec.data.size()); e[7] = uint8_t(sec.data.size() >> 8);
+		}
+		for (sector const &sec : sectors)
+			block.insert(block.end(), sec.data.begin(), sec.data.end());
+		block.resize((block.size() + 255) & ~size_t(255), 0);
+		return block;
+	}
+};
+
+} // anonymous namespace
