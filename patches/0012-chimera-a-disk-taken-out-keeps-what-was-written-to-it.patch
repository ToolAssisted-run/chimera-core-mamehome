--- a/src/devices/imagedev/floppy.cpp
+++ b/src/devices/imagedev/floppy.cpp
@@ -17,6 +17,18 @@
 #include "formats/mfi_dsk.h"
 #include "formats/td0_dsk.h"
 #include "formats/cqm_dsk.h"
+
+#if defined(CHIMERA_CORE)
+#include <map>
+
+// chimera: a disk taken out of a drive keeps what was written to it. MAME
+// writes a changed disk back to its file in the file's own format, and many
+// formats (a CPC's DSK) cannot be written, so the changes would be lost the
+// moment the disk came out. Here a disk's image is kept when it comes out, by
+// the name of its file, and putting that file in again takes the kept image. It is in
+// the machine's memory, so a savestate holds it.
+static std::map<std::string, std::unique_ptr<floppy_image>> s_chimera_kept_disks;
+#endif
 #include "formats/dsk_dsk.h"
 #include "formats/pc_dsk.h"
 #include "formats/ipf_dsk.h"
@@ -685,6 +697,23 @@
 
 std::pair<std::error_condition, std::string> floppy_image_device::call_load()
 {
+#if defined(CHIMERA_CORE)
+	if (auto kept = s_chimera_kept_disks.find(filename()); kept != s_chimera_kept_disks.end())
+	{
+		m_image = std::move(kept->second);
+		s_chimera_kept_disks.erase(kept);
+		// any format of the file's kind: only whether one exists is asked
+		m_output_format = nullptr;
+		for (const floppy_image_format_t *format : m_fif_list)
+			if (!m_output_format || format->extension_matches(filename()))
+				m_output_format = format;
+		m_image_dirty = true;
+		init_floppy_load(m_output_format != nullptr);
+		if (!m_cur_load_cb.isnull())
+			m_cur_load_cb(this);
+		return std::make_pair(std::error_condition(), std::string());
+	}
+#endif
 	check_for_file();
 	auto io = util::random_read_fill(image_core_file(), 0xff);
 	if(!io)
@@ -737,8 +766,20 @@
 	m_dskchg = 0;
 
 	if (m_image) {
+#if defined(CHIMERA_CORE)
+		// a write still going on is put on the disk first, as commit_image does
+		if(m_writing) {
+			write_do_flush(machine().time());
+			m_writing = false;
+		}
+		// kept whether or not it looks changed: MAME clears "changed" when the
+		// motor stops and it has written the disk back, which for a format it
+		// cannot write is nothing at all
+		s_chimera_kept_disks[filename()] = std::move(m_image);
+#else
 		if(m_image_dirty)
 			commit_image();
+#endif
 		m_image.reset();
 	}
 
