+std::vector<std::pair<std::string, std::vector<uint8_t>>> chimera_written_disks(device_t &root)
+{
+	std::map<std::string, const floppy_image *> written;
+	for (auto const &kept : s_chimera_kept_disks)
+		if (kept.second.written && kept.second.image) written[kept.first] = kept.second.image.get();
+	// every kind of drive (a CPC's 3-inch drive is a type of its own)
+	for (device_t &device : device_enumerator(root))
+		if (auto *const drive = dynamic_cast<floppy_image_device *>(&device))
+			if (drive->exists() && drive->m_chimera_written && drive->chimera_image())
+				written[drive->filename()] = drive->chimera_image();
+	std::vector<std::pair<std::string, std::vector<uint8_t>>> out;
+	for (auto const &w : written)
+		out.emplace_back(w.first, chimera_edsk::encode(*w.second));
+	return out;
+}
